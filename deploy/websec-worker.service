[Unit]
Description=websec worker: collectors (CVE/OSV/KEV/EPSS/vendors) -> SQLite -> Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sec/app
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WEBSEC_JOB=1
Environment=SEC_TG=0
# Канал Telegram: пока не задан, посты идут в топик Sec (тестовый режим, лимит в сутки)
# Environment=WEBSEC_TG_CHAT=@channel_name
ExecStart=/home/ubuntu/venvs/websec/bin/python -m websec.worker
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/sec/logs/worker.log
StandardError=append:/home/ubuntu/sec/logs/worker.log

[Install]
WantedBy=multi-user.target
